// Polling App — Prisma schema
// Extensible poll/question model: QuestionType enum + per-question JSON config
// + normalized options/answers so new question types need no destructive migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum QuestionType {
  SINGLE_CHOICE // radio
  MULTI_CHOICE // checkbox
  FREE_TEXT // short answer
  RATING // numeric scale
  // extensible: add DATE, RANKING, etc. later — no schema break
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum CommentVisibility {
  ANONYMOUS
  EDITORS
  EVERYONE
}

// Per-poll access grant roles (additive to owner/invitee model).
//   EDITOR         -> edit content/settings, publish/unpublish, manage
//                     respondent invites; implies viewing results. Cannot
//                     delete the poll or manage grants (owner-only).
//   RESULTS_VIEWER -> view results + full raw-response Excel export.
enum PollRole {
  EDITOR
  RESULTS_VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  polls     Poll[]     @relation("PollCreator")
  invites   Invite[] // invites linked to this user once matched by email
  responses Response[]
  pollAccess PollAccess[] // per-poll access grants linked to this user by email
}

model Poll {
  id          String   @id @default(cuid())
  title       String
  description String?
  isPublished Boolean  @default(false) // draft vs open for answers
  // When true (and published), ANY signed-in user may view + answer via the
  // poll link, without an individual invite or access grant. Default false =
  // invite-only. Sign-in is still required (responses are keyed to a User).
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Poll-level comment visibility policy (creator-selected). Governs how
  // per-question optional comments are surfaced. Default EDITORS = owner-only.
  commentVisibility CommentVisibility @default(EDITORS)

  creatorId String
  creator   User   @relation("PollCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  questions Question[]
  invites   Invite[]
  responses Response[]
  accessGrants PollAccess[] // per-poll access grants (EDITOR / RESULTS_VIEWER)

  @@index([creatorId])
}

model Question {
  id       String       @id @default(cuid())
  pollId   String
  poll     Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  type     QuestionType
  prompt   String
  required Boolean      @default(false)
  order    Int // display ordering within poll
  // Type-specific settings held as JSON so new types need no migration.
  // e.g. RATING    -> { "min":1, "max":5, "step":1, "labels":{...} }
  //      FREE_TEXT -> { "maxLength":500 }
  //      MULTI_CHOICE -> { "maxSelections": 3 }
  config   Json?

  options QuestionOption[]
  answers Answer[]

  @@index([pollId])
}

model QuestionOption {
  id          String         @id @default(cuid())
  questionId  String
  question    Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label       String
  order       Int
  answerLinks AnswerOption[]

  @@index([questionId])
}

model Invite {
  id        String       @id @default(cuid())
  pollId    String
  poll      Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  email     String // normalized lower-case
  status    InviteStatus @default(PENDING)
  token     String       @unique @default(cuid()) // for optional invite link
  createdAt DateTime     @default(now())

  // Linked once the email owns an account (at signup OR invite time if already registered).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([pollId, email]) // one invite per email per poll
  @@index([email])
  @@index([userId])
}

// Per-poll access grant. Mirrors the Invite email-linking pattern: a grant is
// addressed to a normalized email and linked to a concrete account (userId)
// once that email owns one (at grant time if already registered, or at signup
// via linkGrantsToUser). Owner-managed only.
model PollAccess {
  id        String   @id @default(cuid())
  pollId    String
  email     String // normalized lower-case
  userId    String?
  role      PollRole
  createdAt DateTime @default(now())

  poll Poll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([pollId, email]) // one grant per email per poll
  @@index([userId])
  @@index([email])
}

model Response {
  id           String   @id @default(cuid())
  pollId       String
  poll         Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  respondentId String
  respondent   User     @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  answers Answer[]

  @@unique([pollId, respondentId]) // one submission per user per poll (edit-in-place)
  @@index([pollId])
}

model Answer {
  id         String   @id @default(cuid())
  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Type-specific value storage (only the relevant field is populated):
  textValue   String? // FREE_TEXT
  numberValue Int? // RATING
  // Optional free-text comment attached to any question (independent of the
  // answer value). Visibility governed by Poll.commentVisibility.
  comment     String?
  // choice answers (single or multi) via join table below:
  selectedOptions AnswerOption[]

  @@unique([responseId, questionId])
  @@index([questionId])
}

model AnswerOption {
  id       String         @id @default(cuid())
  answerId String
  answer   Answer         @relation(fields: [answerId], references: [id], onDelete: Cascade)
  optionId String
  option   QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  // Nullable 1-based rank for opt-in ranked MULTI_CHOICE (config.ranked).
  // NULL for all non-ranked selections; additive/backward-compatible.
  rank     Int?

  @@unique([answerId, optionId])
  @@index([optionId])
}
