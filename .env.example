# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Matches the docker-compose.yml service credentials for local dev.
DATABASE_URL="postgresql://polling:polling@localhost:5432/polling?schema=public"

# Auth.js (NextAuth v5) secret used to sign/encrypt session JWTs.
# Generate a strong value, e.g. `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET="replace-me-with-a-long-random-string"

# Base URL of the app (used by Auth.js for callbacks). Optional in dev.
# AUTH_URL="http://localhost:3000"

# Email delivery for invites is env-gated. When BOTH values below are set,
# invite emails are sent for real via Resend (https://resend.com). If either is
# missing, delivery gracefully falls back to a dev stub that logs the invite
# link to the server console. NEVER commit a real API key.
#
# Sender address. Must be a verified domain/sender in your Resend account,
# e.g. "Pollster <invites@yourdomain.com>".
# EMAIL_FROM=""
# Resend API key (starts with "re_"). Leave unset in local dev to use the stub.
# RESEND_API_KEY=""
